  "training": {
    "n_gradient_steps": 20,
    "learning_rate": 5e-05,
    "batch_size": 1,
    "reduce_lr_patience": 50000,
    "reduce_lr_factor": 0.25,
    "checkpoint_interval": 200000,
    "device": "cpu"
  },
  "debug": {
    "print_interval": 100,
    "enable_plot": true,
    "plot_interval": 10000,
    "save_plot_figs": true,
    "save_plot_figs_interval": 10000,
    "print_reduce_lr_messages": true
